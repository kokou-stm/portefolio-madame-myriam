# Modèle du fichier .env du serveur : cp env.example .env, puis remplir.
# Le fichier .env n'est jamais commité (.gitignore).

# Base PostgreSQL locale au serveur.
# Mot de passe : lettres et chiffres uniquement (il est inséré dans une URL).
#   Générer : openssl rand -hex 24
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# Clé Django — générer : openssl rand -hex 50
DJANGO_SECRET_KEY=

# Compte Gmail d'envoi des codes 2FA (mêmes valeurs que les secrets GitHub).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DJANGO_DEBUG=0
DJANGO_HTTPS=1
DJANGO_ALLOWED_HOSTS=myriamdossou.com,www.myriamdossou.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://myriamdossou.com,https://www.myriamdossou.com
